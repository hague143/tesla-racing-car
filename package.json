{
  "name": "tesla-night-shift",
  "version": "2.0.0",
  "private": true,
  "description": "An original Three.js night-highway arcade game with jumps, rolls, and boost",
  "scripts": {
    "dev": "vite",
    "start": "vite --host 0.0.0.0 --port 8001",
    "build": "tsc --noEmit && vite build && node scripts/copy-notices.mjs",
    "preview": "vite preview --host 0.0.0.0 --port 8001",
    "test": "tsx --test tests/*.test.ts tests/audio.test.js tests/export.test.js tests/leaderboard.test.js",
    "export:html": "node scripts/export-html.mjs",
    "leaderboard": "node server/leaderboard.mjs"
  },
  "dependencies": {
    "three": "0.180.0"
  },
  "devDependencies": {
    "@types/three": "^0.180.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vite": "^7.3.1"
  },
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  }
}
