# Optional. Leave empty for fully playable local-record mode.
# Only a PUBLIC service URL belongs in this client variable. Never put secrets here.
VITE_LEADERBOARD_URL=

# Separate Node leaderboard service only. Never prefix secrets with VITE_.
# ALLOWED_ORIGIN=https://your-game.example
# LEADERBOARD_SECRET=generate-a-long-random-value-on-your-server
# PORT=8787
